#!/bin/sh

CONFIG="rustdesk-updater.main"
CRONTAB="/etc/crontabs/root"
MARKER="# rustdesk-updater"
LOCK="/tmp/rustdesk-updater-schedule.lock"

log() {
	logger -t rustdesk-updater-schedule "$*"
}

get_config() {
	uci -q get "$CONFIG.$1" 2>/dev/null
}

exec 9>"$LOCK"
flock -n 9 || exit 0

ENABLED="$(get_config enabled)"
AUTO_UPDATE="$(get_config auto_update)"
FREQUENCY="$(get_config frequency)"
HOUR="$(get_config hour)"
WEEKDAY="$(get_config weekday)"

ENABLED="${ENABLED:-1}"
AUTO_UPDATE="${AUTO_UPDATE:-1}"
FREQUENCY="${FREQUENCY:-daily}"
HOUR="${HOUR:-3}"
WEEKDAY="${WEEKDAY:-1}"

case "$ENABLED" in
	0|1) ;;
	*) log "Invalid enabled value"; exit 1 ;;
esac

case "$AUTO_UPDATE" in
	0|1) ;;
	*) log "Invalid auto_update value"; exit 1 ;;
esac

case "$FREQUENCY" in
	disabled|daily|weekly) ;;
	*) log "Invalid frequency"; exit 1 ;;
esac

case "$HOUR" in
	''|*[!0-9]*) log "Invalid hour"; exit 1 ;;
esac

[ "$HOUR" -ge 0 ] && [ "$HOUR" -le 23 ] || {
	log "Hour must be between 0 and 23"
	exit 1
}

case "$WEEKDAY" in
	1|2|3|4|5|6|7) ;;
	*) log "Invalid weekday"; exit 1 ;;
esac

mkdir -p /etc/crontabs || exit 1
umask 077

TMP="${CRONTAB}.tmp.$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM

if [ -f "$CRONTAB" ]; then
	awk -v marker="$MARKER" 'index($0, marker) == 0' "$CRONTAB" > "$TMP" || exit 1
else
	: > "$TMP"
fi

if [ "$ENABLED" = "1" ] && [ "$AUTO_UPDATE" = "1" ]; then
	case "$FREQUENCY" in
		daily)
			printf '0 %s * * * /usr/libexec/rustdesk-updater-auto %s\n' \
				"$HOUR" "$MARKER" >> "$TMP"
			;;
		weekly)
			CRON_DAY="$WEEKDAY"
			[ "$CRON_DAY" = "7" ] && CRON_DAY="0"
			printf '0 %s * * %s /usr/libexec/rustdesk-updater-auto %s\n' \
				"$HOUR" "$CRON_DAY" "$MARKER" >> "$TMP"
			;;
	esac
fi

if [ -f "$CRONTAB" ] && cmp -s "$TMP" "$CRONTAB"; then
	rm -f "$TMP"
	trap - EXIT HUP INT TERM
	exit 0
fi

chmod 600 "$TMP" || exit 1
mv -f "$TMP" "$CRONTAB" || {
	log "Failed to install crontab"
	exit 1
}

trap - EXIT HUP INT TERM

/etc/init.d/cron restart || {
	log "Failed to restart cron"
	exit 1
}

log "Schedule updated"
exit 0
